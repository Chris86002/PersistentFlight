@LAZYGLOBAL OFF.
WAIT UNTIL ADDONS:PFR:AVAILABLE.
WAIT 5.
SET ADDONS:PFR:PILOTENGINETAG TO "NODE_ENGINE".
SET ADDONS:PFR:FUELRESERVEDV TO 125.
IF NOT ADDONS:PFR:CHECKFUEL(25) { PRINT ADDONS:PFR:FUELCHECK. }
IF NOT ADDONS:PFR:FUELKNOWN OR ADDONS:PFR:FUELLEFTDV < ADDONS:PFR:FUELRESERVEDV { PRINT "FAIL fuel bindings". }
PRINT ADDONS:PFR:FUELCHECK.
RUNPATH("0:/pf_mission_pilot.ks","NODE_ENGINE").
